# Copy to .env. The agent plans with the local vision box by default, so for a
# normal setup this file can stay empty.

# Local OpenAI-compat vision box (Qwen3-VL on a GB10 / llama.cpp on :8080).
# This is the planner the app is built around: it reads drawings, constructs
# buildings, and edits the live model. Set these only to point at a different
# host or a different gguf.
# ECON_LOCAL_LLM_URL=http://10.0.1.20:8080/v1
# ECON_LOCAL_LLM_MODEL=Qwen3VL-30B-A3B-Instruct-Q4_K_M.gguf

# Everything below is an optional fallback for when the VL box is off. With no
# key and no box reachable, /api/agent replies 204 and the chat drops to the
# keyword heuristics in inferSpecFromPrompt, which only ever produce five
# hardcoded shapes.

# Replicate — runs google/gemini-3.5-flash (replicate.com/account/api-tokens)
REPLICATE_API_TOKEN=

# Groq — has a free tier (console.groq.com)
GROQ_API_KEY=

# OpenAI (platform.openai.com)
OPENAI_API_KEY=

# OpenRouter (openrouter.ai)
OPENROUTER_API_KEY=

# Vercel AI Gateway
AI_GATEWAY_API_KEY=

# Pin the provider and model instead of autodetecting.
# ECON_AGENT_PROVIDER=local
# ECON_AGENT_MODEL=Qwen3VL-30B-A3B-Instruct-Q4_K_M.gguf

# No key and no VL box: run `ollama serve` on this machine and it is picked up
# automatically from 127.0.0.1:11434.
