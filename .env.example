# Copy to .env to let the agent plan buildings with a model.
# Without one of these (and with no local Ollama), /api/agent replies 204 and
# the chat silently falls back to the keyword heuristics in inferSpecFromPrompt,
# which only ever produce five hardcoded shapes.
#
# Any single one of these is enough. Providers are tried in this order.

# Replicate — runs google/gemini-3.5-flash (replicate.com/account/api-tokens)
REPLICATE_API_TOKEN=

# Cursor — easiest path is `npm run login:cursor`, which mints a key into
# ~/.cursor/sdk/auth.json and needs nothing here. Set this only for CI or if you
# would rather manage the key yourself (cursor.com/dashboard/integrations).
CURSOR_API_KEY=

# Groq — has a free tier (console.groq.com)
GROQ_API_KEY=

# OpenAI (platform.openai.com)
OPENAI_API_KEY=

# OpenRouter (openrouter.ai)
OPENROUTER_API_KEY=

# Vercel AI Gateway
AI_GATEWAY_API_KEY=

# Pin the provider and model instead of autodetecting.
# ECON_AGENT_PROVIDER=groq
# ECON_AGENT_MODEL=llama-3.3-70b-versatile

# No key at all: run `ollama serve` on this machine and it is picked up
# automatically from 127.0.0.1:11434.
